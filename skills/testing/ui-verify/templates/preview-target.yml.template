# Commit this at .claude/aw-targets/preview.yml
#
# It is the browser context for verifying PR preview deployments. The runner
# reads it, then OVERRIDES base_url at runtime with the URL it resolves from the
# GitHub deployments API for the specific PR — so leave base_url as the
# placeholder below. Commit this file (it carries NO secrets); gitignore whatever
# storage-state file it points at (.auth/*.json, or your repo's convention such
# as .browser/auth-state.preview.json).
#
# Reuses the aw-target.yml schema verbatim — see
# skills/workflow/autonomous-workflow/templates/aw-target.yml.template for the
# full field reference. Only the preview-specific notes are repeated here.

name: preview

# Overridden at runtime by ui-verify's URL resolution. The literal value here
# is never used; keep it as a marker so a misconfigured run fails loudly.
base_url: RESOLVED_AT_RUNTIME

auth:
  # See rules/preview-auth.md for the full flow (local one-time capture + the
  # non-interactive CI path). NO SECRET EVER GOES IN THIS FILE — credentials live
  # in env vars / the OS keychain; this file names WHICH env var, never a value.
  # Commit this; gitignore whatever storage_state path it points at.
  #
  # REUSE an existing repo auth convention rather than scaffolding a parallel one
  # (see aw-setup's "Reuse before you scaffold"). A per-host preview session
  # differs per PR and per push, so `when: always` re-captures every run.
  strategy: none            # one of: none | bypass-header | storage-state | manual

  # ── OUTER WALL: host deployment protection (Vercel/Netlify/etc.) ──────────────
  # Composes with ANY strategy. When the preview URL itself is gated (a Vercel
  # protection page loads BEFORE the app), send a bypass header on EVERY request —
  # the login navigation and every spec navigation alike. The value comes from an
  # env var (a CI secret), never from this file.
  # bypass_header:
  #   name: x-vercel-protection-bypass
  #   env: VERCEL_AUTOMATION_BYPASS_SECRET   # names the env var; no value here

  # ── INNER WALL: app login (Clerk / SSO / etc.) ───────────────────────────────
  # storage_state + a refresh command that logs in NON-INTERACTIVELY from env vars
  # and writes the gitignored session. This is the CI path: CI sets the secrets as
  # env vars, refresh.command reads them (never chat, never a file), writes state.
  # storage_state: .browser/auth-state.preview.json   # gitignored
  # authed_check: '{role: "button", name: "Account menu"}'  # present ONLY when
  #   signed in — the positive signal a session is valid. The runner/aw-tester
  #   checks it before authed specs; absent → refresh, don't trust the file.
  #   Written in the spec locator grammar (not a forked syntax). See
  #   rules/preview-auth.md § Confirming a session.
  # refresh:
  #   when: always
  #   env: [PREVIEW_USER, PREVIEW_PASSWORD, VERCEL_AUTOMATION_BYPASS_SECRET]
  #   command: |
  #     PREVIEW_URL="${PREVIEW_URL}" \
  #       AUTH_STORAGE_STATE=.browser/auth-state.preview.json \
  #       node .claude/aw-targets/refresh-auth.mjs   # scaffold: templates/refresh-auth.mjs.template
  #   timeout_seconds: 180
  #
  # ── BOTH WALLS (e.g. dash0: Vercel protection + Clerk/Google login) ───────────
  # Layer them — bypass_header to reach the app past Vercel protection, THEN the
  # storage-state login. refresh-auth.mjs applies the bypass header to its own
  # context so it can reach the login page, and aw-tester applies it to the run
  # context so every spec navigation gets through too. Uncomment strategy:
  # storage-state, the bypass_header block, and the refresh block together.

# ── PR preview URL resolution (optional) ─────────────────────────────────────
# ui-verify resolves a PR's preview URL from the GitHub deployments API and the
# provider's bot comment (see rules/preview-url-resolution.md). That covers a
# GitHub-integrated host (Vercel/Netlify/…) that registers a deployment or posts
# a recognizable provider bot comment. If YOUR previews are deployed another way
# — a CLI `vercel deploy` in your own CI, a github-actions[bot] sticky comment, a
# stable per-PR alias that isn't `*-git-*` — the generic resolver finds nothing
# and every run needs a manual --url. Configure it here instead so `ui-verify
# run` finds the URL on its own. `--url` still overrides everything.
# preview_url:
#   # (A) Read the REAL posted URL from a comment the generic scan misses: widen
#   #     the trusted comment authors and give the host regex for your STABLE
#   #     per-PR alias. This reads a published URL — never a fabricated one.
#   comment:
#     authors: [github-actions]                            # ADDED to vercel/netlify/cloudflare/render
#     host_pattern: 'myapp-pr-\d+-myscope\.vercel\.app'    # regex; the stable per-PR alias host
#   # (B) OR a deterministic alias TEMPLATE, when your CI publishes a stable
#   #     per-PR alias. {pr} = PR number, {branch} = slugified head ref, {sha} =
#   #     head SHA. Sanctioned ONLY because it is read from THIS committed file
#   #     (not a slug you inferred) and the resolver reachability-checks it before
#   #     use, falling through to the generic resolver if it 404s.
#   template: 'https://myapp-pr-{pr}-myscope.vercel.app'

fixtures:
  # A preview usually points at a shared staging database, so seeding is often a
  # no-op. Reference dynamic ids the same way as any aw-target.
  references:
    # dashboardId: ${SEED_DASHBOARD_ID}

constraints:
  parallelism: 1
  reset_between_specs: false
