# local-verify — skill defaults (the lowest config layer).
# Copy to a repo's .claude/local-verify.yml to commit team defaults, and keep
# only the keys you change. Personal values belong in the local file instead.
# Layer order, later wins: this file → .claude/local-verify.yml
# → ~/.claude/local-verify.local.yml (top level, then repos.<owner>/<name>)
# → .claude/local-verify.local.yml.
version: 2

# Markdown file of repo facts (auth quirks, commit format, test commands); see rules/setup.md.
notes: ""

# The URL the browser phase opens. Required; setup detects or asks for it.
app_url: ""

# The ui-verify aw-target to sign in with; empty → specs run without a target login.
aw_target: ""

intent:
  # linear | github-issue | none — where acceptance criteria come from besides the PR.
  tracker: github-issue

stack:
  # cli | compose | command | none (see rules/local-stack.md).
  driver: none
  # Optional liveness URL checked after start, besides app_url.
  api_health_url: ""
  # Path prefixes a running dev server picks up without a restart.
  hot_reload: []
  # Files whose change needs a full restart, besides .env*.
  config_files: []
  # Changed path prefix → component names (driver-specific); longest prefix wins.
  component_map: {}
  # Started when no prefix matches; empty → everything the driver knows.
  default: []
  # cli driver: command templates (see rules/stack/cli.md)
  cli: {}
  # compose driver
  compose:
    files: []
    project: ""
    profiles: []
  # command driver: [{ name, run, cwd, ready_url, port }]
  commands: []
  ready_timeout_seconds: 180

telemetry:
  # dash0-mcp | logs | none (see rules/telemetry-review.md).
  backend: logs
  # Seconds to wait after a probe before treating missing telemetry as absent.
  ingest_wait_seconds: 0
  loops: 2
  thresholds:
    # An interactive request slower than this is a finding.
    interactive_span_ms: 1000
    # More identical child operations than this under one request is an N+1 finding.
    repeated_child_spans: 10

fix:
  # The repo's fast test command for a touched package; empty → detect (rules/fix-loop.md).
  test_command: ""
