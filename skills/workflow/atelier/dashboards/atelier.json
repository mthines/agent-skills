{
  "kind": "Dashboard",
  "metadata": {
    "name": "atelier",
    "project": "agent-skills"
  },
  "spec": {
    "display": {
      "name": "atelier",
      "description": "How many changes atelier ships, where each run spends its time, where it gets stuck, and whether its merges stay merged. Subject: service_name=\"atelier\" (namespace agent-skills); a run is one atelier.run span. Schema: skills/workflow/atelier/rules/telemetry.md."
    },
    "duration": "30d",
    "variables": [],
    "panels": {
      "runs_total": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Runs",
            "description": "atelier runs that ended in the range (one per /atelier invocation; a resume is a new run). Smoke runs excluded."
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "decimal"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(increase({otel_metric_name=\"atelier.runs\", service_name=\"atelier\", atelier_smoke=\"\"}[$__range] anchored))"
                  }
                }
              }
            }
          ]
        }
      },
      "merged_total": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "PRs merged",
            "description": "PRs atelier squash-merged in the range."
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "decimal"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(increase({otel_metric_name=\"atelier.prs.merged\", service_name=\"atelier\", atelier_smoke=\"\"}[$__range] anchored))"
                  }
                }
              }
            }
          ]
        }
      },
      "merge_rate": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Merge rate",
            "description": "Share of runs that ended merged."
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "percentunit"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(increase({otel_metric_name=\"atelier.prs.merged\", service_name=\"atelier\", atelier_smoke=\"\"}[$__range] anchored)) / sum(increase({otel_metric_name=\"atelier.runs\", service_name=\"atelier\", atelier_smoke=\"\"}[$__range] anchored))"
                  }
                }
              }
            }
          ]
        }
      },
      "revert_rate": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Revert rate",
            "description": "Merged PRs outcomes.mjs later classified reverted, over all classified PRs (outcome transitions; a clean PR later reverted counts in both)."
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "percentunit"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(increase({otel_metric_name=\"atelier.outcomes\", service_name=\"atelier\", atelier_smoke=\"\", atelier_outcome=\"reverted\"}[$__range] anchored)) / sum(increase({otel_metric_name=\"atelier.outcomes\", service_name=\"atelier\", atelier_smoke=\"\"}[$__range] anchored))"
                  }
                }
              }
            }
          ]
        }
      },
      "runs_by_outcome": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Runs per day by outcome",
            "description": "merged · held · refused · failed · stopped (preflight stop) · abandoned (session ended with no record)."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom"
              },
              "visual": {
                "display": "bar",
                "stack": "all"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (atelier_run_outcome) (increase({otel_metric_name=\"atelier.runs\", service_name=\"atelier\", atelier_smoke=\"\"}[1d] anchored))",
                    "seriesNameFormat": "{{atelier_run_outcome}}"
                  }
                }
              }
            }
          ]
        }
      },
      "merged_per_week": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "PRs merged per week",
            "description": ""
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "legend": {
                "position": "bottom"
              },
              "visual": {
                "display": "bar",
                "stack": "all"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum(increase({otel_metric_name=\"atelier.prs.merged\", service_name=\"atelier\", atelier_smoke=\"\"}[7d] anchored))",
                    "seriesNameFormat": "merged"
                  }
                }
              }
            }
          ]
        }
      },
      "where_runs_stop": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Where runs stop",
            "description": "Runs by the stage they ended in and how they ended — the stuck point."
          },
          "plugin": {
            "kind": "BarChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "decimal"
              },
              "sort": "desc"
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (atelier_stage_reached, atelier_run_outcome) (increase({otel_metric_name=\"dash0.spans\", service_name=\"atelier\", otel_span_name=\"atelier.run\", atelier_smoke=\"\"}[$__range]))",
                    "seriesNameFormat": "{{atelier_stage_reached}} · {{atelier_run_outcome}}"
                  }
                }
              }
            }
          ]
        }
      },
      "stage_p50": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Stage duration p50",
            "description": "p50 wall time per stage, from the atelier.stage.duration histogram (build = aw; ready includes CI waits)."
          },
          "plugin": {
            "kind": "BarChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "seconds"
              },
              "sort": "desc"
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.5, sum by (atelier_stage_name) (increase({otel_metric_name=\"atelier.stage.duration\", service_name=\"atelier\", atelier_smoke=\"\"}[$__range])))",
                    "seriesNameFormat": "{{atelier_stage_name}}"
                  }
                }
              }
            }
          ]
        }
      },
      "stage_p90": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Stage duration p90",
            "description": "p90 wall time per stage, from the atelier.stage.duration histogram (build = aw; ready includes CI waits)."
          },
          "plugin": {
            "kind": "BarChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "seconds"
              },
              "sort": "desc"
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.9, sum by (atelier_stage_name) (increase({otel_metric_name=\"atelier.stage.duration\", service_name=\"atelier\", atelier_smoke=\"\"}[$__range])))",
                    "seriesNameFormat": "{{atelier_stage_name}}"
                  }
                }
              }
            }
          ]
        }
      },
      "stage_total": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Total time per stage",
            "description": "Where all runs' wall time went, summed per stage."
          },
          "plugin": {
            "kind": "BarChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "seconds"
              },
              "sort": "desc"
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_sum(sum by (atelier_stage_name) (increase({otel_metric_name=\"atelier.stage.duration\", service_name=\"atelier\", atelier_smoke=\"\"}[$__range])))",
                    "seriesNameFormat": "{{atelier_stage_name}}"
                  }
                }
              }
            }
          ]
        }
      },
      "waiting": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Waiting time by kind",
            "description": "ci / review / other: commands run through telemetry.mjs wait; human: idle time between a hold and the resume."
          },
          "plugin": {
            "kind": "BarChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "seconds"
              },
              "sort": "desc"
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_sum(sum by (atelier_wait_kind) (increase({otel_metric_name=\"atelier.wait.duration\", service_name=\"atelier\", atelier_smoke=\"\"}[$__range])))",
                    "seriesNameFormat": "{{atelier_wait_kind}}"
                  }
                }
              }
            }
          ]
        }
      },
      "active_vs_wait": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Active vs waiting",
            "description": "Stage time minus in-run waits is agent-active time."
          },
          "plugin": {
            "kind": "BarChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "seconds"
              },
              "sort": "desc"
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_sum(sum(increase({otel_metric_name=\"atelier.stage.duration\", service_name=\"atelier\", atelier_smoke=\"\"}[$__range]))) - histogram_sum(sum(increase({otel_metric_name=\"atelier.wait.duration\", service_name=\"atelier\", atelier_wait_kind!=\"human\", atelier_smoke=\"\"}[$__range])))",
                    "seriesNameFormat": "active"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_sum(sum(increase({otel_metric_name=\"atelier.wait.duration\", service_name=\"atelier\", atelier_wait_kind!=\"human\", atelier_smoke=\"\"}[$__range])))",
                    "seriesNameFormat": "waiting in run"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_sum(sum(increase({otel_metric_name=\"atelier.wait.duration\", service_name=\"atelier\", atelier_wait_kind=\"human\", atelier_smoke=\"\"}[$__range])))",
                    "seriesNameFormat": "waiting on a human"
                  }
                }
              }
            }
          ]
        }
      },
      "holds": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Holds, refusals, failures by reason",
            "description": "Bounded reason buckets per stage (atelier.stage.reason_bucket)."
          },
          "plugin": {
            "kind": "BarChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "decimal"
              },
              "sort": "desc"
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (atelier_stage_name, atelier_stage_decision, atelier_stage_reason_bucket) (increase({otel_metric_name=\"dash0.spans\", service_name=\"atelier\", otel_span_name=~\"atelier.stage .*\", atelier_stage_decision=~\"hold|refuse|failed\", atelier_smoke=\"\"}[$__range]))",
                    "seriesNameFormat": "{{atelier_stage_name}} {{atelier_stage_decision}} · {{atelier_stage_reason_bucket}}"
                  }
                }
              }
            }
          ]
        }
      },
      "companions": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Companions skipped",
            "description": "Runs whose Build hand-back skipped a required companion, by the skipped set."
          },
          "plugin": {
            "kind": "BarChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "decimal"
              },
              "sort": "desc"
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (atelier_companions_skipped) (increase({otel_metric_name=\"dash0.spans\", service_name=\"atelier\", otel_span_name=\"atelier.run\", atelier_companions_skipped!=\"\", atelier_smoke=\"\"}[$__range]))",
                    "seriesNameFormat": "{{atelier_companions_skipped}}"
                  }
                }
              }
            }
          ]
        }
      },
      "preflight": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Preflight gaps",
            "description": "Runs by the preflight gap set."
          },
          "plugin": {
            "kind": "BarChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "decimal"
              },
              "sort": "desc"
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (atelier_preflight_gaps) (increase({otel_metric_name=\"dash0.spans\", service_name=\"atelier\", otel_span_name=\"atelier.run\", atelier_preflight_gaps!=\"\", atelier_smoke=\"\"}[$__range]))",
                    "seriesNameFormat": "{{atelier_preflight_gaps}}"
                  }
                }
              }
            }
          ]
        }
      },
      "outcomes": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Merged PR outcomes",
            "description": "Transitions outcomes.mjs recorded: clean · reverted · hotfixed."
          },
          "plugin": {
            "kind": "BarChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "decimal"
              },
              "sort": "desc"
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (atelier_outcome) (increase({otel_metric_name=\"atelier.outcomes\", service_name=\"atelier\", atelier_smoke=\"\"}[$__range] anchored))",
                    "seriesNameFormat": "{{atelier_outcome}}"
                  }
                }
              }
            }
          ]
        }
      },
      "memory": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "LoreKit per run",
            "description": "Runs by LoreKit status and by how many aw lessons the Build applied."
          },
          "plugin": {
            "kind": "BarChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "decimal"
              },
              "sort": "desc"
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (atelier_memory_lorekit) (increase({otel_metric_name=\"dash0.spans\", service_name=\"atelier\", otel_span_name=\"atelier.run\", atelier_smoke=\"\"}[$__range]))",
                    "seriesNameFormat": "lorekit {{atelier_memory_lorekit}}"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (atelier_memory_lessons_used) (increase({otel_metric_name=\"dash0.spans\", service_name=\"atelier\", otel_span_name=\"atelier.run\", atelier_memory_lessons_used!=\"\", atelier_smoke=\"\"}[$__range]))",
                    "seriesNameFormat": "{{atelier_memory_lessons_used}} lessons"
                  }
                }
              }
            }
          ]
        }
      },
      "now_by_stage": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "In flight by stage",
            "description": "Runs that have not ended, by the stage they are in and whether they are active or waiting (ci, review, human). A held run is ended here: it shows under Recently ended."
          },
          "plugin": {
            "kind": "BarChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "decimal"
              },
              "sort": "desc"
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "count by (atelier_stage_name, atelier_run_state) (topk by (atelier_run_id) (1, last_over_time({otel_metric_name=\"atelier.run.state\", service_name=\"atelier\", atelier_smoke=\"\"}[3d])) unless on (atelier_run_id) last_over_time({otel_metric_name=\"atelier.run.state\", service_name=\"atelier\", atelier_smoke=\"\", atelier_run_state=~\"merged|held|refused|failed|stopped|abandoned\"}[3d]))",
                    "seriesNameFormat": "{{atelier_stage_name}} · {{atelier_run_state}}"
                  }
                }
              }
            }
          ]
        }
      },
      "now_prs": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "In flight PRs",
            "description": "One bar per run that has not ended: work ref (the PR, else ticket or repo@branch) · stage · state. Each bar is 1; the state changed at the gauge value (atelier.run.state)."
          },
          "plugin": {
            "kind": "BarChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "decimal"
              },
              "sort": "asc"
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "count by (atelier_work_ref, atelier_stage_name, atelier_run_state) (topk by (atelier_run_id) (1, last_over_time({otel_metric_name=\"atelier.run.state\", service_name=\"atelier\", atelier_smoke=\"\"}[3d])) unless on (atelier_run_id) last_over_time({otel_metric_name=\"atelier.run.state\", service_name=\"atelier\", atelier_smoke=\"\", atelier_run_state=~\"merged|held|refused|failed|stopped|abandoned\"}[3d]))",
                    "seriesNameFormat": "{{atelier_work_ref}} · {{atelier_stage_name}} · {{atelier_run_state}}"
                  }
                }
              }
            }
          ]
        }
      },
      "now_ended": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Recently ended",
            "description": "Runs that ended in the range: work ref · how it ended · stage · why (bounded reason). A failed or held run names its reason here. A resume is a new run, so a held PR also appears In flight once resumed."
          },
          "plugin": {
            "kind": "BarChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "decimal"
              },
              "sort": "asc"
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "count by (atelier_work_ref, atelier_run_state, atelier_stage_name, atelier_reason_bucket) (last_over_time({otel_metric_name=\"atelier.run.state\", service_name=\"atelier\", atelier_smoke=\"\", atelier_run_state=~\"merged|held|refused|failed|stopped|abandoned\"}[$__range]))",
                    "seriesNameFormat": "{{atelier_work_ref}} · {{atelier_run_state}} at {{atelier_stage_name}} · {{atelier_reason_bucket}}"
                  }
                }
              }
            }
          ]
        }
      },
      "rollout_now": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Rollouts in progress",
            "description": "Merged PRs whose deployment-verify rollout has not finished: PR · phase (deploy, baseline, step, hold, rollback) · step percent. A hold waits for a human approve or override."
          },
          "plugin": {
            "kind": "BarChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "decimal"
              },
              "sort": "asc"
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "count by (atelier_work_ref, deployment_phase, deployment_step) (topk by (atelier_work_ref) (1, last_over_time({otel_metric_name=\"deployment.rollout.state\", service_name=\"deployment-verify\", atelier_smoke=\"\"}[7d])) unless on (atelier_work_ref) last_over_time({otel_metric_name=\"deployment.rollout.state\", service_name=\"deployment-verify\", atelier_smoke=\"\", deployment_phase=\"done\"}[7d]))",
                    "seriesNameFormat": "{{atelier_work_ref}} · {{deployment_phase}} {{deployment_step}}"
                  }
                }
              }
            }
          ]
        }
      },
      "rollout_ended": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Rollouts finished",
            "description": "Rollouts that reached a verdict in the range: PR · outcome (PASS, ROLLED_BACK, ESCALATE, …). The reason is in the PR report comment."
          },
          "plugin": {
            "kind": "BarChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "decimal"
              },
              "sort": "asc"
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "count by (atelier_work_ref, deployment_outcome) (last_over_time({otel_metric_name=\"deployment.rollout.state\", service_name=\"deployment-verify\", atelier_smoke=\"\", deployment_phase=\"done\"}[$__range]))",
                    "seriesNameFormat": "{{atelier_work_ref}} · {{deployment_outcome}}"
                  }
                }
              }
            }
          ]
        }
      }
